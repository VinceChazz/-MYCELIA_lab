# Copy to .env. Never put secrets in the frontend or commit this file.
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1
ROOT_TO_POWER_DB=data/local_database/root_to_power.sqlite
DEMO_MODE=true
# Required before enabling any future physical pump adapter.
PUMP_OPERATOR_KEY=
SENSOR_INGEST_KEY=
# Optional upstream synchronization service (local SQLite still works without it).
SYNC_TARGET_URL=
SYNC_API_KEY=
# Optional compatible weather/market JSON feeds; demo cache is the default.
WEATHER_API_URL=
MARKET_API_URL=
